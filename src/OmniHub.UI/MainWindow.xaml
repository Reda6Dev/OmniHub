<Window x:Class="OmniHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:OmniHub.UI.Converters"
        xmlns:comp="clr-namespace:OmniHub.UI.Components"
        xmlns:vm="clr-namespace:OmniHub.UI.ViewModels"
        xmlns:enums="clr-namespace:OmniHub.Core.Enums;assembly=OmniHub.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="OmniHub - Developer &amp; Gaming Omni-Hub"
        Icon="app.ico"
        Width="1100"
        Height="700"
        MinWidth="950"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgDarkestBrush}"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        StateChanged="MainWindow_StateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:ComparisonConverter x:Key="CompareConv"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Window Title Bar Control Button Style -->
        <Style x:Key="WindowControlBtnStyle"
                TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="btnBorder"
                                        Property="Background"
                                        Value="{StaticResource BgCardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="btnBorder"
                                        Property="Opacity"
                                        Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseBtnStyle"
                TargetType="Button"
                BasedOn="{StaticResource WindowControlBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                    Value="True">
                                <Setter TargetName="btnBorder"
                                        Property="Background"
                                        Value="#EF4444"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                    Value="True">
                                <Setter TargetName="btnBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl"
                Key="K"
                Command="{Binding TogglePaletteCommand}"/>
        <KeyBinding Modifiers="Ctrl"
                Key="P"
                Command="{Binding TogglePaletteCommand}"/>
        <KeyBinding Key="Escape"
                Command="{Binding ClosePaletteCommand}"/>
        <KeyBinding Key="F12"
                Command="{Binding ToggleTerminalCommand}"/>
    </Window.InputBindings>

    <Grid>
        <!-- Main Application Shell -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0"
                    Background="{StaticResource BgSidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Logo & Branding -->
                    <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentCyanBrush}"
                                CornerRadius="8"
                                Width="28"
                                Height="28"
                                Margin="0,0,10,0">
                            <TextBlock Text="⚡"
                                    FontSize="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="#050811"/>
                        </Border>
                        <TextBlock Text="OMNIHUB"
                                FontWeight="Black"
                                FontSize="15"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                VerticalAlignment="Center"/>
                        <TextBlock Text=" Hub"
                                FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"/>
                    </StackPanel>

                    <!-- Center Quick Search Launcher (Ctrl+K) -->
                    <Button Grid.Column="1"
                            Style="{StaticResource ModernGhostButton}"
                            Command="{Binding TogglePaletteCommand}"
                            HorizontalAlignment="Center"
                            Width="340"
                            Height="32"
                            Padding="12,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                    Text="🔍"
                                    FontSize="12"
                                    Margin="0,0,8,0"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                    Text="{Binding QuickSearchPlaceholderText}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12"
                                    VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Background="{StaticResource BgInputBrush}"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <TextBlock Text="Ctrl + K"
                                        FontSize="10"
                                        Foreground="{StaticResource AccentCyanBrush}"
                                        FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Right Controls & Integrated Window Buttons -->
                    <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                        <!-- Language Switcher Button -->
                        <Button Style="{StaticResource ModernGhostButton}"
                                Command="{Binding ToggleLanguageCommand}"
                                Height="32"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                FontSize="12"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                ToolTip="تبديل اللغة (عربي / English)">
                            <TextBlock Text="{Binding CurrentLanguageButtonText}"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"/>
                        </Button>

                        <!-- User Manual Button -->
                        <Button Style="{StaticResource ModernGhostButton}"
                                Command="{Binding OpenManualCommand}"
                                Height="32"
                                Padding="10,0"
                                Margin="0,0,6,0"
                                FontSize="12"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <TextBlock Text="📖 "
                                        FontSize="12"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ManualButtonText}"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Live Terminal Toggle Button -->
                        <Button Style="{StaticResource ModernGhostButton}"
                                Command="{Binding ToggleTerminalCommand}"
                                Height="32"
                                Padding="10,0"
                                Margin="0,0,8,0"
                                FontSize="12"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="{Binding TerminalButtonText}"
                                    VerticalAlignment="Center"/>
                        </Button>

                        <!-- Subtle Separator -->
                        <Rectangle Width="1"
                                Height="20"
                                Fill="{StaticResource BorderBrush}"
                                Margin="0,0,8,0"/>

                        <!-- Window Minimize Button -->
                        <Button Style="{StaticResource WindowControlBtnStyle}"
                                Click="OnMinimizeButtonClick"
                                Width="34"
                                Height="32"
                                ToolTip="تصغير (Minimize)">
                            <TextBlock Text="—"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>

                        <!-- Window Maximize / Restore Button -->
                        <Button Style="{StaticResource WindowControlBtnStyle}"
                                Click="OnMaximizeButtonClick"
                                Width="34"
                                Height="32"
                                ToolTip="تكبير / استعادة (Maximize / Restore)">
                            <TextBlock x:Name="MaximizeRestoreIcon"
                                    Text="🗖"
                                    FontSize="11"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>

                        <!-- Window Close Button -->
                        <Button Style="{StaticResource WindowCloseBtnStyle}"
                                Click="OnCloseButtonClick"
                                Width="36"
                                Height="32"
                                ToolTip="إغلاق (Close)">
                            <TextBlock Text="✕"
                                    FontSize="12"
                                    Foreground="{StaticResource TextSecondaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Split Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar Navigation -->
                <Border Grid.Column="0"
                        Background="{StaticResource BgSidebarBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="12,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                Text="{Binding HubsSectionHeader}"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextMutedBrush}"
                                Margin="8,0,0,12"/>

                        <!-- Dynamic Hubs / Wings -->
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Wings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton Style="{StaticResource SidebarNavButton}"
                                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         Command="{Binding DataContext.SelectWingCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                         CommandParameter="{Binding Id}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding GlyphIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Style="{StaticResource ModernGhostButton}" Command="{Binding OpenAddWingCommand}" Height="34" Padding="8,0" HorizontalContentAlignment="Left">
                                    <TextBlock Text="{Binding AddWingButtonText}" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource ModernGhostButton}" Command="{Binding OpenOnlineToolsCommand}" Height="34" Padding="8,0" HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding OnlineToolsButtonText}" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource ModernGhostButton}" Command="{Binding EditSelectedWingCommand}" IsEnabled="{Binding CanEditSelectedWing}" Height="30" Padding="8,0" HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="✏  " FontSize="11"/><TextBlock Text="{Binding EditWingButtonText}" FontSize="11"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernGhostButton}" Command="{Binding DeleteSelectedWingCommand}" IsEnabled="{Binding CanDeleteSelectedWing}" Height="30" Padding="8,0" HorizontalContentAlignment="Left" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="🗑  " Foreground="#FCA5A5" FontSize="11"/><TextBlock Text="{Binding DeleteWingButtonText}" Foreground="#FCA5A5" FontSize="11"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Bottom Version Info -->
                        <Border Grid.Row="2"
                                Background="{StaticResource BgDarkestBrush}"
                                CornerRadius="6"
                                Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="OmniHub v1.0"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Config-Driven Automation"
                                        FontSize="10"
                                        Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Hub Workspace & Live Terminal -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="{Binding EffectiveTerminalHeight, Mode=TwoWay}"/>
                    </Grid.RowDefinitions>

                    <!-- Active Hub Tools List -->
                    <ScrollViewer Grid.Row="0"
                            Padding="20,16"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Focusable="False">
                        <StackPanel>
                            <!-- Hub Header -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedWingDisplayTitle}"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedWingDisplaySubtitle}"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Margin="0,4,0,0"/>
                                </StackPanel>
                                <!-- أدوات Custom Tools: الأزرار داخل حاوية أفقية لمنع التداخل -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding SelectedWing, Converter={StaticResource CompareConv}, ConverterParameter=Custom}">
                                    <Button Style="{StaticResource ModernGhostButton}"
                                            Command="{Binding OpenAddCustomToolCommand}"
                                            Padding="12,6"
                                            Cursor="Hand"
                                            ToolTip="إنشاء أداة مخصصة بدون كتابة JSON">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="➕ " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AddToolButtonText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ModernGhostButton}"
                                            Margin="8,0,0,0"
                                            Command="{Binding OpenConfigsFolderCommand}"
                                            Padding="10,6"
                                            ToolTip="فتح مجلد configs/tools">
                                        <TextBlock Text="📂" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Tool Cards List (1-Column Full Width) -->
                            <ItemsControl ItemsSource="{Binding CurrentWingTools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <comp:ToolCardControl DataContext="{Binding}" Margin="0,0,0,14"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State for Custom Tools -->
                            <Border Margin="0,30,0,0"
                                    Padding="24"
                                    MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    Background="{StaticResource BgCardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Visibility="{Binding ShowCustomEmptyState, Converter={StaticResource BoolToVis}}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Background="#1E1B4B"
                                            CornerRadius="25"
                                            Width="50"
                                            Height="50"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,14">
                                        <TextBlock Text="🧩"
                                                FontSize="24"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{Binding CustomEmptyStateTitle}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,6"/>

                                    <TextBlock Text="{Binding CustomEmptyStateMessage}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               LineHeight="18"
                                               Margin="0,0,0,18"/>

                                    <Button Style="{StaticResource ModernPrimaryButton}"
                                            Command="{Binding OpenAddCustomToolCommand}"
                                            HorizontalAlignment="Center"
                                            Height="36"
                                            Padding="16,0">
                                        <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="➕  "
                                                    FontSize="11"
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding AddCustomToolButtonText}"
                                                    FontWeight="SemiBold"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Splitter between Tools & Terminal -->
                    <GridSplitter Grid.Row="1"
                                  Height="4"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center"
                                  Background="{StaticResource BorderBrush}"
                                  ShowsPreview="True"
                                  Visibility="{Binding IsTerminalOpen, Converter={StaticResource BoolToVis}}"/>

                    <!-- Live Terminal Drawer (Bottom) -->
                    <comp:LiveTerminalControl Grid.Row="2"
                                              DataContext="{Binding Terminal}"
                                              Visibility="{Binding DataContext.IsTerminalOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- Command Palette Modal Overlay -->
        <comp:CommandPaletteOverlay x:Name="PaletteOverlayControl"
                                    DataContext="{Binding Palette}"
                                    Visibility="{Binding DataContext.IsCommandPaletteOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                    CloseRequested="OnPaletteCloseRequested"/>

        <!-- Online Tools Modal -->
        <Grid Visibility="{Binding IsOnlineToolsOpen, Converter={StaticResource BoolToVis}}" Background="#99000000" Panel.ZIndex="120">
            <Border Width="920" Height="650" MaxHeight="680" Padding="22" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding OnlineTools.Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding OnlineTools.Subtitle}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource ModernGhostButton}" Command="{Binding CloseOnlineToolsCommand}" Content="✕" Padding="10,5"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding OnlineTools.CatalogLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding OnlineTools.CatalogUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding OnlineTools.LoadCatalogCommand}" Padding="14,7" Content="{Binding OnlineTools.LoadText}"/>
                            <Button Style="{StaticResource ModernGhostButton}" Command="{Binding OnlineTools.TrustCurrentRepositoryCommand}" Padding="12,7" Margin="8,0,0,0" Content="{Binding OnlineTools.TrustButtonText}" ToolTip="{Binding OnlineTools.TrustButtonHint}" Visibility="{Binding OnlineTools.ShowTrustButton, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0" Style="{StaticResource ModernTextBox}" Text="{Binding OnlineTools.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding OnlineTools.SearchPlaceholder}" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding OnlineTools.Tools}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- Vector Glyph Badge (Segoe Fluent Icons) -->
                                                        <Border Grid.Column="0"
                                                                Width="34"
                                                                Height="34"
                                                                Background="#111B2E"
                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Margin="0,0,10,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GlyphIcon}"
                                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                       FontSize="16"
                                                                       Foreground="{StaticResource AccentCyanBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding DisplayName}"/>
                                                            <TextBlock Text="{Binding DisplayDescription}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" ToolTip="{Binding DisplayDescription}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="44,4,0,0">
                                                        <TextBlock Text="{Binding Item.Category}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding VersionLineText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding PublisherText}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="44,2,0,0" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding TrustBadgeText}" FontSize="10" Margin="44,2,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#F97316"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsTrustedRepository}" Value="True">
                                                                        <Setter Property="Foreground" Value="#22C55E"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                                                    <Button DockPanel.Dock="Left" Style="{StaticResource ModernGhostButton}" Command="{Binding DataContext.OnlineTools.ShowToolDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Padding="8,4" Content="{DynamicResource DetailsButton}" ToolTip="عرض تفاصيل الأداة والوصف الكامل" FontSize="11" VerticalAlignment="Center"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding DataContext.OnlineTools.InstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Visibility="{Binding ShowInstallButton, Converter={StaticResource BoolToVis}}" Padding="10,5" Content="{Binding InstallText}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding DataContext.OnlineTools.InstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Visibility="{Binding ShowUpdateButton, Converter={StaticResource BoolToVis}}" Padding="10,5" Margin="0,0,6,0" Content="{Binding UpdateButtonText}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Button Style="{StaticResource ModernGhostButton}" Command="{Binding DataContext.OnlineTools.UninstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}" Visibility="{Binding ShowUninstallButton, Converter={StaticResource BoolToVis}}" Padding="8,5" Margin="6,0,0,0" Content="{Binding UninstallText}" Foreground="#EF4444" FontSize="11" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <DockPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="{Binding OnlineTools.StatusText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ModernGhostButton}" Command="{Binding CloseOnlineToolsCommand}" Padding="14,7" Margin="12,0,0,0" Content="{Binding CancelButtonText}"/>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Tool Details Dialog Overlay inside Online Tools -->
            <Grid Visibility="{Binding OnlineTools.IsDetailsDialogOpen, Converter={StaticResource BoolToVis}}" Background="#B3000000" Panel.ZIndex="130">
                <Border Width="560" MaxHeight="520" Padding="20" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40"
                                        Height="40"
                                        Background="#111B2E"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OnlineTools.SelectedToolForDetails.GlyphIcon}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="20"
                                               Foreground="{StaticResource AccentCyanBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OnlineTools.SelectedToolForDetails.DisplayName}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding OnlineTools.SelectedToolForDetails.Item.Id}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource ModernGhostButton}" Command="{Binding OnlineTools.CloseToolDetailsCommand}" Content="✕" Padding="10,5"/>
                        </Grid>

                        <!-- Details Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,14">
                            <StackPanel>
                                <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource ToolFullDescriptionLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="{Binding OnlineTools.SelectedToolForDetails.DisplayDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" LineHeight="18"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource CategoryLabel}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OnlineTools.SelectedToolForDetails.Item.Category}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,3"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource VersionLabel}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OnlineTools.SelectedToolForDetails.VersionLineText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,3"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource PublisherLabel}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OnlineTools.SelectedToolForDetails.PublisherText}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,3,0,3"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource SecurityStatusLabel}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnlineTools.SelectedToolForDetails.TrustBadgeText}" Foreground="#22C55E" Margin="0,3,0,3"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="بصمة SHA-256:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3" Visibility="{Binding OnlineTools.SelectedToolForDetails.HasSha256, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding OnlineTools.SelectedToolForDetails.Sha256Text}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,3" Visibility="{Binding OnlineTools.SelectedToolForDetails.HasSha256, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <DockPanel Grid.Row="2">
                            <Button DockPanel.Dock="Right" Style="{StaticResource ModernGhostButton}" Command="{Binding OnlineTools.CloseToolDetailsCommand}" Content="{Binding OnlineTools.CloseDetailsText}" Padding="14,7"/>
                        </DockPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Add Custom Tool Modal -->
        <Grid Visibility="{Binding IsToolEditorOpen, Converter={StaticResource BoolToVis}}" Background="#99000000" Panel.ZIndex="110">
            <Border Width="680" Height="650" MaxHeight="650" Padding="24" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ToolEditorTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                    <!-- المحتوى قابل للتمرير، بينما أزرار الإجراءات ثابتة بالأسفل -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="{Binding ToolTitleLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewToolTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                            <TextBlock Text="{Binding ToolExecutionTypeLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <ComboBox SelectedValue="{Binding NewToolExecutionType}" SelectedValuePath="Tag" Margin="0,5,0,10">
                                <ComboBoxItem Content="External Process — برنامج" Tag="{x:Static enums:ExecutionType.ExternalProcess}"/>
                                <ComboBoxItem Content="PowerShell — سكربت" Tag="{x:Static enums:ExecutionType.PowerShell}"/>
                            </ComboBox>

                            <TextBlock Text="{Binding ToolExecutableLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <Grid Margin="0,5,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding NewToolExecutable, UpdateSourceTrigger=PropertyChanged}" ToolTip="مثال: ffmpeg.exe أو C:\Tools\mytool.exe" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Style="{StaticResource ModernGhostButton}" Command="{Binding BrowseToolExecutableCommand}" Padding="12,6" Content="..." ToolTip="اختيار البرنامج أو السكربت من الجهاز"/>
                            </Grid>

                            <TextBlock Text="{Binding ToolArgumentsLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewToolArguments, UpdateSourceTrigger=PropertyChanged}" ToolTip="مثال: -i ${InputFile} -o ${OutputFile}" Margin="0,5,0,12"/>

                            <Expander Header="الإعدادات المتقدمة" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="10" Margin="0,0,0,12">
                                <StackPanel Margin="0,10,0,0">
                                    <TextBlock Text="{Binding ToolTitleArLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewToolTitleAr, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                                    <TextBlock Text="{Binding ToolDescriptionLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewToolDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>
                                    <TextBlock Text="الوصف بالعربية (اختياري)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewToolDescriptionAr, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

                                    <TextBlock Text="{Binding ToolWorkingDirectoryLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NewToolWorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,4"/>
                                    <TextBlock Text="اتركه فارغاً لاستخدام مجلد البرنامج الافتراضي." Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                </StackPanel>
                            </Expander>

                            <Border Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="{Binding ToolParametersLabel}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource ModernGhostButton}" Command="{Binding AddToolParameterCommand}" HorizontalAlignment="Right" Padding="10,5" Content="{Binding AddParameterButtonText}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding NewToolParameters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.2*"/>
                                                            <ColumnDefinition Width="1.4*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" ToolTip="ID — مثال InputFile" Margin="0,0,6,0"/>
                                                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" ToolTip="اسم المدخل" Margin="0,0,6,0"/>
                                                        <ComboBox Grid.Column="2" SelectedValue="{Binding Type}" SelectedValuePath="Tag" Margin="0,0,6,0">
                                                            <ComboBoxItem Content="Text" Tag="{x:Static enums:ParameterType.Text}"/>
                                                            <ComboBoxItem Content="FilePath" Tag="{x:Static enums:ParameterType.FilePath}"/>
                                                            <ComboBoxItem Content="DirectoryPath" Tag="{x:Static enums:ParameterType.DirectoryPath}"/>
                                                            <ComboBoxItem Content="Number" Tag="{x:Static enums:ParameterType.Number}"/>
                                                            <ComboBoxItem Content="Checkbox" Tag="{x:Static enums:ParameterType.Checkbox}"/>
                                                        </ComboBox>
                                                        <TextBox Grid.Column="3" Style="{StaticResource ModernTextBox}" Text="{Binding DefaultValue, UpdateSourceTrigger=PropertyChanged}" ToolTip="القيمة الافتراضية" Margin="0,0,6,0"/>
                                                        <Button Grid.Column="4" Style="{StaticResource ModernGhostButton}" Command="{Binding DataContext.RemoveToolParameterCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}" Content="✕" Padding="8,4"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding ToolFileHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,16"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" Padding="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ModernGhostButton}" Command="{Binding CancelAddCustomToolCommand}" Padding="16,8" Margin="0,0,8,0" Content="{Binding CancelButtonText}"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding SaveCustomToolCommand}" Padding="16,8" Content="{Binding SaveToolButtonText}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Add Wing Modal -->
        <Grid Visibility="{Binding IsWingEditorOpen, Converter={StaticResource BoolToVis}}" Background="#99000000" Panel.ZIndex="100">
            <Border Width="560" MaxHeight="650" Padding="24" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding WingEditorTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                        <TextBlock Text="{Binding WingNameLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <Grid Margin="0,5,0,2">
                            <TextBox x:Name="WingNameBox" Style="{StaticResource ModernTextBox}" Text="{Binding NewWingName, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding WingNameHint}"/>
                            <TextBlock Text="{Binding WingNamePlaceholder}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=WingNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding WingNameHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding WingTitleOtherLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                        <Grid Margin="0,5,0,2">
                            <TextBox x:Name="WingEnglishNameBox" Style="{StaticResource ModernTextBox}" Text="{Binding NewWingTitleOther, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding WingTitleOtherHint}"/>
                            <TextBlock Text="{Binding WingTitleOtherPlaceholder}" Foreground="{StaticResource TextMutedBrush}" Margin="10,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=WingEnglishNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding WingTitleOtherHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding WingIconLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <UniformGrid Columns="8" Rows="1" Margin="0,0,0,8">
                            <Button Style="{StaticResource ModernGhostButton}" Content="🎮" Command="{Binding SelectWingIconCommand}" CommandParameter="🎮" Margin="2" FontSize="20"/>
                            <Button Style="{StaticResource ModernGhostButton}" Content="🛠️" Command="{Binding SelectWingIconCommand}" CommandParameter="🛠️" Margin="2" FontSize="20"/>
                            <Button Style="{StaticResource ModernGhostButton}" Content="🐍" Command="{Binding SelectWingIconCommand}" CommandParameter="🐍" Margin="2" FontSize="20"/>
                            <Button Style="{StaticResource ModernGhostButton}" Content="📁" Command="{Binding SelectWingIconCommand}" CommandParameter="📁" Margin="2" FontSize="20"/>
                            <Button Style="{StaticResource ModernGhostButton}" Content="⚡" Command="{Binding SelectWingIconCommand}" CommandParameter="⚡" Margin="2" FontSize="20"/>
                            <Button Style="{StaticResource ModernGhostButton}" Content="📦" Command="{Binding SelectWingIconCommand}" CommandParameter="📦" Margin="2" FontSize="20"/>
                            <Button Style="{StaticResource ModernGhostButton}" Content="🌐" Command="{Binding SelectWingIconCommand}" CommandParameter="🌐" Margin="2" FontSize="20"/>
                            <Button Style="{StaticResource ModernGhostButton}" Content="⚙️" Command="{Binding SelectWingIconCommand}" CommandParameter="⚙️" Margin="2" FontSize="20"/>
                        </UniformGrid>
                        <TextBlock Text="{Binding WingIconHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,18">
                            <TextBlock Text="{Binding WingCustomIconLabel}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Style="{StaticResource ModernTextBox}" Width="90" Text="{Binding NewWingIcon, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="18"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ModernGhostButton}" Command="{Binding CancelAddWingCommand}" Padding="16,8" Margin="0,0,8,0" Content="{Binding CancelButtonText}"/>
                            <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding CreateWingCommand}" Padding="16,8" Content="{Binding CreateWingButtonText}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- User Manual Modal Overlay -->
        <comp:UserManualOverlay DataContext="{Binding Manual}" Visibility="{Binding DataContext.IsUserManualOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                CloseRequested="OnManualCloseRequested"/>
    </Grid>
</Window>
