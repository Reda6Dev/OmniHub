<UserControl x:Class="OmniHub.UI.Components.ToolCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:comp="clr-namespace:OmniHub.UI.Components"
             xmlns:vm="clr-namespace:OmniHub.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ToolItemViewModel}"
             Margin="0,0,0,14">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource ModernCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Background="#1E1B4B" BorderBrush="{StaticResource AccentPurpleBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Tool.ExecutionType}" Foreground="{StaticResource AccentPurpleBrush}" FontSize="10" FontWeight="SemiBold" />
                    </Border>

                    <!-- Interactive Guide / Info Button (?) -->
                    <Button Style="{StaticResource ModernGhostButton}"
                            Command="{Binding ToggleGuideCommand}"
                            Padding="8,2" FontSize="11" Margin="0,0,6,0"
                            ToolTip="دليل استخدام الأداة وسيناريوهات العمل اليومية (Interactive Guide)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GuideButtonText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ModernGhostButton}"
                            Content="{Binding IsExpanded, ConverterParameter='Collapse|Expand'}"
                            Command="{Binding ToggleExpandCommand}"
                            Padding="8,2" FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Interactive Guide Panel (Collapsible) -->
            <Border Grid.Row="1"
                    Background="#0A1120"
                    BorderBrush="{StaticResource AccentCyanBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsGuideOpen, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📘 " FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="دليل وسيناريو الاستخدام (Interactive Usage Guide)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ModernGhostButton}" Content="✕" Command="{Binding ToggleGuideCommand}" Padding="6,1" FontSize="10" ToolTip="Close guide" />
                    </Grid>

                    <!-- Guide Details (Single-Language based on Active Setting) -->
                    <Grid Grid.Row="1">
                        <!-- Arabic Guide Panel (Active when IsArabic is true) -->
                        <Border Background="#111B2E" CornerRadius="6" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsArabic, Converter={StaticResource BoolToVis}}">
                            <StackPanel FlowDirection="RightToLeft">
                                <TextBlock Text="🇸🇦 دليل وسيناريو الاستخدام" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentGreenBrush}" Margin="0,0,0,8" />
                                
                                <TextBlock Text="الوظيفة:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" />
                                <TextBlock Text="{Binding Guide.WhatItDoesAr}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18" Margin="0,2,0,10" />

                                <TextBlock Text="متى تستخدمها؟" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentAmberBrush}" />
                                <TextBlock Text="{Binding Guide.WhenToUseAr}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18" Margin="0,2,0,10" />

                                <TextBlock Text="مثال المدخلات:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" />
                                <TextBlock Text="{Binding Guide.ExampleAr}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Foreground="#E2E8F0" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- English Guide Panel (Active when English is selected) -->
                        <Border Background="#111B2E" CornerRadius="6" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Visibility="{Binding IsEnglish, Converter={StaticResource BoolToVis}}">
                            <StackPanel FlowDirection="LeftToRight">
                                <TextBlock Text="🇬🇧 Usage Guide &amp; Scenario" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8" />
                                
                                <TextBlock Text="What it does:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" />
                                <TextBlock Text="{Binding Guide.WhatItDoesEn}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18" Margin="0,2,0,10" />

                                <TextBlock Text="When to use:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentAmberBrush}" />
                                <TextBlock Text="{Binding Guide.WhenToUseEn}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18" Margin="0,2,0,10" />

                                <TextBlock Text="Example parameters:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPurpleBrush}" />
                                <TextBlock Text="{Binding Guide.ExampleEn}" TextWrapping="Wrap" FontSize="11" FontFamily="Consolas" Foreground="#E2E8F0" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Dynamic Parameters Section -->
            <Border Grid.Row="2" 
                    Background="#0D1322" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="6" 
                    Padding="12,12,12,4" 
                    Margin="0,0,0,12"
                    Visibility="{Binding HasParameters, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <comp:DynamicParameterControl DataContext="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Card Footer / Actions -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status text when running -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⚡ Executing tool..." Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>

                <!-- Run Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource ModernPrimaryButton}"
                        Command="{Binding ExecuteCommand}"
                        IsEnabled="{Binding CanExecute}"
                        Height="36"
                        MinWidth="120"
                        Padding="14,0"
                        FontSize="12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▶  " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RunButtonText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
