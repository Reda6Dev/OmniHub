<UserControl x:Class="OmniHub.UI.Components.CommandPaletteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OmniHub.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel}"
             Visibility="Collapsed"
             PreviewKeyDown="OnOverlayPreviewKeyDown">

    <!-- Dark Semi-transparent backdrop -->
    <Grid Background="#B3050811" PreviewMouseDown="OnBackdropPreviewMouseDown">
        <!-- Floating Dialog Box -->
        <Border x:Name="DialogBorder"
                Width="680"
                MaxWidth="760"
                MaxHeight="520"
                VerticalAlignment="Top"
                Margin="0,70,0,0"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource AccentCyanBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#000000" Opacity="0.8" ShadowDepth="10" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Input Bar -->
                <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Style="{StaticResource ModernTextBox}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="15"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="OnSearchBoxKeyDown" />

                        <Button Grid.Column="2"
                                x:Name="CloseBadgeButton"
                                Click="OnCloseButtonClick"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                ToolTip="Click to close (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="badgeBorder"
                                            Background="{StaticResource BgSidebarBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2">
                                        <TextBlock x:Name="badgeText"
                                                   Text="ESC to close" 
                                                   FontSize="10" 
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="badgeBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                            <Setter TargetName="badgeBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                                            <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="badgeBorder" Property="Opacity" Value="0.7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Results List -->
                <ListBox x:Name="ResultsList"
                         Grid.Row="1"
                         ItemsSource="{Binding FilteredTools}"
                         SelectedItem="{Binding SelectedTool, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         MaxHeight="360"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PreviewKeyDown="OnListKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,10" />
                            <Setter Property="Margin" Value="4,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource BgCardHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#2D3B4E" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="#111827" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer Hint -->
                <Border Grid.Row="2" Background="#0F172A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Tip: Use " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        <TextBlock Text="↑ ↓" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" to navigate, " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        <TextBlock Text="Enter" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" to run, " Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                        <TextBlock Text="Esc" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" />
                        <TextBlock Text=" to dismiss" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

