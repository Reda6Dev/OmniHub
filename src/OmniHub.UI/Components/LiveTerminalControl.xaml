<UserControl x:Class="OmniHub.UI.Components.LiveTerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:OmniHub.UI.Converters"
             xmlns:vm="clr-namespace:OmniHub.UI.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TerminalViewModel}"
             Background="{StaticResource BgTerminalBrush}">

    <UserControl.Resources>
        <conv:LogLevelToColorConverter x:Key="LogLevelToColor" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Terminal Header Bar -->
        <Border Grid.Row="0" Background="#0A0E1A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Terminal Title & Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TERMINAL" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    
                    <!-- Running Pulse Indicator -->
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentCyanBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    
                    <!-- Error / Warning counters -->
                    <Border Background="#371B1B" CornerRadius="4" Padding="6,2" Margin="10,0,4,0" Visibility="{Binding ErrorCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ErrorCount, StringFormat='{}Errors: {0}'}" FontSize="11" Foreground="{StaticResource AccentRedBrush}" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#372D1B" CornerRadius="4" Padding="6,2" Margin="4,0" Visibility="{Binding WarningCount, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding WarningCount, StringFormat='{}Warnings: {0}'}" FontSize="11" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Auto-Scroll" IsChecked="{Binding AutoScroll}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
                    
                    <Button Style="{StaticResource ModernGhostButton}" Content="Copy" Command="{Binding CopyLogsCommand}" Padding="8,3" FontSize="11" Margin="0,0,6,0" ToolTip="Copy all output to clipboard" />
                    <Button Style="{StaticResource ModernGhostButton}" Content="Clear" Command="{Binding ClearCommand}" Padding="8,3" FontSize="11" Margin="0,0,6,0" ToolTip="Clear terminal screen" />
                    
                    <!-- Kill Process Button (Visible when running) -->
                    <Button Style="{StaticResource ModernDangerButton}" Content="Kill Process" Command="{Binding KillProcessCommand}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Padding="10,3" FontSize="11" ToolTip="Force terminate running process and all child processes" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Log Lines Viewport -->
        <ListBox x:Name="LogsListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding Logs}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="2,1" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12">
                        <Run Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss} '}" Foreground="{StaticResource TextMutedBrush}" />
                        <Run Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}" />
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>

