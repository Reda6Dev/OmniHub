<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Slate Gaming Palette -->
    <Color x:Key="BgDarkestColor">#0B0F19</Color>
    <Color x:Key="BgSidebarColor">#0F172A</Color>
    <Color x:Key="BgCardColor">#1E293B</Color>
    <Color x:Key="BgCardHoverColor">#27354A</Color>
    <Color x:Key="BgInputColor">#0F172A</Color>
    <Color x:Key="BgTerminalColor">#050811</Color>
    
    <Color x:Key="BorderColor">#334155</Color>
    <Color x:Key="BorderFocusColor">#06B6D4</Color>
    
    <Color x:Key="AccentCyanColor">#06B6D4</Color>
    <Color x:Key="AccentCyanHoverColor">#22D3EE</Color>
    <Color x:Key="AccentPurpleColor">#8B5CF6</Color>
    <Color x:Key="AccentGreenColor">#10B981</Color>
    <Color x:Key="AccentAmberColor">#F59E0B</Color>
    <Color x:Key="AccentRedColor">#EF4444</Color>

    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="BgDarkestBrush" Color="{StaticResource BgDarkestColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BgTerminalBrush" Color="{StaticResource BgTerminalColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentCyanHoverBrush" Color="{StaticResource AccentCyanHoverColor}" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

</ResourceDictionary>

